{
  "name": "fastify-web-bot-auth",
  "version": "0.1.1",
  "description": "Fastify plugin that verifies Web Bot Auth signatures (RFC 9421 + IETF web-bot-auth drafts) on inbound requests",
  "type": "module",
  "license": "MIT",
  "author": "Umar <umarg1997@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umxr/fastify-web-bot-auth.git"
  },
  "homepage": "https://github.com/umxr/fastify-web-bot-auth#readme",
  "bugs": {
    "url": "https://github.com/umxr/fastify-web-bot-auth/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:dist": "npm run build && node scripts/dist-smoke.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fastify",
    "fastify-plugin",
    "web-bot-auth",
    "http-message-signatures",
    "rfc9421",
    "ed25519",
    "ai-agents",
    "bot-verification"
  ],
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.1",
    "jsonwebkey-thumbprint": "^0.1.0",
    "structured-headers": "^2.0.1",
    "web-bot-auth": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.4",
    "fastify": "^5.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
